 "sector": "Government bond",
 "profiles": [
  {
   "from": "1975-01",
   "tagline": "Lend the US government money and get 100 back on 1 January 2030.",
   "about": "A promise by the US Treasury to pay 100 dollars on 1 January 2030. It pays nothing before that, so it costs less than 100 today and the difference is your interest. If interest rates rise in the meantime the price falls, and if they fall it rises; the further away 2030 is, the stronger the effect. Held until 2030, it pays exactly what was promised."
  }
