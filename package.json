{
  "name": "marketsim",
  "private": true,
  "workspaces": [
    "shared",
    "data",
    "server",
    "web"
  ],
  "scripts": {
    "data:fetch": "npm run fetch -w data",
    "data:build": "npm run build -w data",
    "data:validate": "npm run validate -w data",
    "test": "npm test -w shared && npm test -w server",
    "typecheck": "npm run typecheck -w shared && tsc --noEmit -p data && npm run typecheck -w server && npm run check -w web",
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "start": "npm run start -w server",
    "build": "npm run build -w web",
    "data:news": "npm run news -w data"
  }
}
